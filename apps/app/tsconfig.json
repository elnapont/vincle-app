{
  "extends": "expo/tsconfig.base",
  "_comentari": "types: node hi és pels fitxers de prova, que s'executen amb el executor de proves de Node. Sense això, tsc no coneix ni node:test ni node:assert.",
  "compilerOptions": {
    "strict": true,
    "paths": {
      "@/*": [
        "./src/*"
      ],
      "@/assets/*": [
        "./assets/*"
      ]
    },
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts"
  ]
}
