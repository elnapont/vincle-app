# Configuració del desplegament. Copia't-lo a `.env` dins d'aquesta carpeta.
#
#   cp desplegament/.env.example desplegament/.env
#   node desplegament/genera-claus.mjs   # i enganxa-hi les quatre línies
#
# El `.env` NO va al repositori: el .gitignore de l'arrel ja el barra.

# On es veurà Vincle des de fora. Ha de ser l'adreça de debò, amb esquema:
# és el que se li cou a l'aplicació perquè hi busqui l'API, i el que GoTrue
# fa servir per als enllaços que envia.
URL_PUBLICA=http://192.168.1.50:8080

# Port del servidor on escolta el contenidor web. Darrere d'un proxy amb HTTPS
# (Caddy, nginx, Traefik), deixa'l a 8080 i que el proxy hi vagi.
PORT_PUBLIC=8080

# Les quatre que dona `node desplegament/genera-claus.mjs`.
POSTGRES_PASSWORD=
JWT_SECRET=
ANON_KEY=
SERVICE_ROLE_KEY=

# Token de The Dog API. Sense això, la funció de races només pot servir la còpia
# que ja tingui desada a la base de dades.
DOG_API_KEY=
